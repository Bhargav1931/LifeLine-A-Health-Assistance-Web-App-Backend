# ==============================================================================
# LIFELINE BACKEND - ENVIRONMENT VARIABLES TEMPLATE (RENDER / PRODUCTION)
# ==============================================================================

# PostgreSQL Connection String (Render PostgreSQL Database)
# Render provides URLs in the format: postgres://<user>:<password>@<host>/<database>
# Our backend automatically handles both 'postgres://' and 'postgresql://' prefixes.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Server Port (Render sets this dynamically via $PORT)
PORT=8000

# Application Environment (development / production)
ENVIRONMENT=production

# Allowed CORS Origins (e.g. '*' or 'https://your-frontend.onrender.com')
ALLOWED_ORIGINS=*
